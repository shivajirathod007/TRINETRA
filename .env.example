# ─── TRINETRA Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to git

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trinetra:trinetra_pass@localhost:5432/trinetra
DATABASE_URL_SYNC=postgresql://trinetra:trinetra_pass@localhost:5432/trinetra

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_hex_string_before_production
CERTIFICATE_SIGNING_KEY=change_this_to_another_random_64_char_hex_string

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Scanning Config ──────────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=50
SCAN_TIMEOUT_SECONDS=30
CT_LOG_CACHE_TTL_HOURS=24
RATE_LIMIT_SCANS_PER_HOUR=20

# ─── CRQC Timeline ────────────────────────────────────────────────────────────
CRQC_PESSIMISTIC_YEAR=2028
CRQC_MODERATE_YEAR=2032
CRQC_OPTIMISTIC_YEAR=2037

# ─── AI Module (fill when AI team delivers) ───────────────────────────────────
ANTHROPIC_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.60
DISTILBERT_MODEL_PATH=./models/crypto_classifier

# ─── CT Log Sources ───────────────────────────────────────────────────────────
CRTSH_BASE_URL=https://crt.sh
CT_LOG_TIMEOUT_SECONDS=30
