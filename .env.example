# ─── TRINETRA Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to git

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trinetra:trinetra_pass@localhost:5432/trinetra
DATABASE_URL_SYNC=postgresql://trinetra:trinetra_pass@localhost:5432/trinetra

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_hex_string_before_production
CERTIFICATE_SIGNING_KEY=change_this_to_another_random_64_char_hex_string

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Scanning Config ──────────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=50
SCAN_TIMEOUT_SECONDS=30
CT_LOG_CACHE_TTL_HOURS=24
RATE_LIMIT_SCANS_PER_HOUR=20

# ─── CRQC Timeline ────────────────────────────────────────────────────────────
CRQC_PESSIMISTIC_YEAR=2028
CRQC_MODERATE_YEAR=2032
CRQC_OPTIMISTIC_YEAR=2037

# ─── AI Module ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is OPTIONAL — leave blank for fully on-premises operation.
# When blank, the classifier uses the built-in rule-based fallback instead of Claude.
ANTHROPIC_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.60
DISTILBERT_MODEL_PATH=./models/crypto_classifier

# ─── CT Log Sources ───────────────────────────────────────────────────────────
CRTSH_BASE_URL=https://crt.sh
CT_LOG_TIMEOUT_SECONDS=30

# ─── Email/SMTP Configuration ─────────────────────────────────────────────────
# For Gmail: Use App Password (not regular password)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com

# Alternative SMTP providers:
# - Outlook: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - SendGrid: smtp.sendgrid.net:587
# - AWS SES: email-smtp.us-east-1.amazonaws.com:587

# ─── Ollama Configuration ─────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=jarsh-phi3
